    { "id": "S4", "description": "Divide the dough into 3 pieces", "duration_min": 3, "active": true, "tools": ["chef_knife", "cutting_board"], "depends_on": ["S3"], "ingredients": [] },
    { "id": "S5", "description": "Shape into 6 ropes about 14 inches long", "duration_min": 9, "active": true, "tools": [], "depends_on": ["S4"], "ingredients": [] },
    { "id": "S6", "description": "Braid into two challahs; seal the ends", "duration_min": 7, "active": true, "tools": [], "depends_on": ["S5"], "ingredients": [] },
    { "id": "S7", "description": "Second rise on sheet pans; preheat oven to 425°F", "duration_min": 42, "active": false, "tools": ["oven", "sheet_pan"], "depends_on": ["S6"], "ingredients": [] },
