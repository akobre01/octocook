    { "id": "S2", "description": "Stem the kale and tear into pieces", "duration_min": 4, "active": true, "tools": [], "depends_on": [], "ingredients": ["4 cups packed curly kale"] },
    { "id": "S3", "description": "Heat oil and sauté onion until translucent", "duration_min": 5, "active": true, "tools": ["stockpot", "stove_burner"], "depends_on": ["S0"], "ingredients": ["2 tbsp extra-virgin olive oil"] },
    { "id": "S4", "description": "Add ginger and garlic; cook until fragrant", "duration_min": 2, "active": true, "tools": ["stockpot", "stove_burner"], "depends_on": ["S3"], "ingredients": [] },
